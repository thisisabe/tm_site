# ─────────────────────────────────────────────
# Thinker Maker – environment variables
# Copy this file to .env.local and fill in values.
# ─────────────────────────────────────────────

# Resend API key (get one at resend.com)
RESEND_API_KEY=re_xxxxx

# Email address that receives contact form submissions
CONTACT_TO_EMAIL=abe@thinkermaker.com.au

# "From" address for outbound emails.
# Must be a domain verified in your Resend account.
# Use onboarding@resend.dev for local development (Resend sandbox).
RESEND_FROM_EMAIL=contact@thinkermaker.com.au

# ─────────────────────────────────────────────
# WordPress (headless CMS)
# Base URL of your WordPress site (no trailing slash)
# ─────────────────────────────────────────────
WORDPRESS_API_URL=https://your-wordpress-site.com
